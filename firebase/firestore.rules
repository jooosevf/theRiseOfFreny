rules_version = '2';

// Security rules for The Rise of Freny.
// Never publish this file as it is: __SCORE_KEY__ would become a public signing key and anyone
// could forge scores. Tools/ScoreKey/make_score_key.py writes firestore.rules.publish, with the
// secret key, and that is what the console or `firebase deploy` takes (docs/firebase/SETUP.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // One board per arena difficulty (leaderboard_hard, _freny, _medium, _easy), with one
    // entry per player holding their best score there. Anyone can read a board; a player can
    // only write their own entry, and the score can only go up.
    // A new score needs the signature of the ranking API (validSig): freny-online's api/run/finish
    // only gives it to a run whose kill log adds up to the score and fits the game's rules and
    // the real time the run took. updatedAt is the server's clock, and an entry takes at most one
    // write every 20 s. Renaming (only "name" changes) needs no signature, and neither does
    // "rebirths" (Renascer's count, the star after the name: cosmetic, the game sends it with a
    // rename or a new score once the player has rebirthed).
    // "leaderboard" is the old board that mixed every difficulty: still readable, no longer writable.
    // A banned account (bans/, only the API writes it) writes nothing here, not even with a signature
    // it was given before: signatures don't expire.
    match /{board}/{userId} {
      allow read: if isBoard(board) || board == 'leaderboard';
      allow create: if isBoard(board) && isOwner(userId) && notBanned() && validEntry() && validSig(board, userId);
      allow update: if isBoard(board) && isOwner(userId) && notBanned() && validEntry()
                    && request.time > resource.data.get('updatedAt', timestamp.value(0)) + duration.value(20, 's')
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'rebirths', 'updatedAt'])
                        || (request.resource.data.score >= resource.data.score && validSig(board, userId)));
      allow delete: if false;
    }

    // Each player's profile and lifetime stats, private to them.
    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && validSave();
      allow delete: if false;
    }

    // The player's three save slots (coins, XP, upgrades, stages), private to them.
    // "slots" is the JSON written by CloudProgressSync.
    match /progress/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                            && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
                            && request.resource.data.slots is string
                            && request.resource.data.slots.size() <= 200000;
      allow delete: if false;
    }

    // The Conquistas: one field per achievement the ranking API signed for this player
    // (api/achievements/claim checks the run's log backs it up), plus "played" for players who
    // finished a manual run the API accepted. Anyone can read and count them (the site shows the
    // share of players with each one); fields only get added, each with its signature.
    // "title" is the Título the player picked to show next to the name in the ranking
    // (PlayerTitles): "" (none), "rei" (the game and the site only show it next to whoever is 1st on
    // the Difícil board) or the key of a Conquista whose signed field is in this same document.
    match /achievements/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && notBanned() && validAchievements(userId);
      allow delete: if false;
    }

    // ---- contas, perfil e amigos (2026-11-02) ----
    // "account" below is a player with an email login: a guest (anonymous login) plays everything,
    // but has no nickname, public profile or friends.

    // Who owns a nickname. The id is the nickname in plain lowercase ("José_1" -> "jose_1", the
    // game's ProfileService.NickKey and the site's nickKey), so "jose" can't be taken next to "José".
    // Created once, never changed; only its owner frees it (renaming). Anyone can look one up.
    // One per account (2026-11-04): a nickname is only created in the same commit that puts it on
    // the account's public profile, and the profile only changes nickname when that commit also
    // frees the old one (validPerfil), so nobody can hoard nicknames.
    match /apelidos/{key} {
      allow read: if true;
      allow create: if isAccount() && key.matches('[a-z0-9_-]{3,16}')
                    && request.resource.data.keys().hasOnly(['uid', 'apelido', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.apelido is string
                    && request.resource.data.apelido.size() >= 3 && request.resource.data.apelido.size() <= 16
                    && nickKey(request.resource.data.apelido) == key
                    && request.resource.data.criadoEm == request.time
                    && getAfter(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.chave == key;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Who owns a friend code, FRENY-XXXX. Created once, never changed. One per account: created in
    // the same commit that puts it on the public profile, whose code never changes once set.
    match /codigos/{code} {
      allow read: if true;
      allow create: if isAccount() && code.matches('FRENY-[2-9A-HJ-NP-Z]{4}')
                    && request.resource.data.keys().hasOnly(['uid', 'criadoEm'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.criadoEm == request.time
                    && getAfter(/databases/$(database)/documents/perfis/$(request.auth.uid)).data.codigo == code;
      allow update, delete: if false;
    }

    // The account's stats, the game's Perfil (PlayerStats): written once when a run ends and read
    // once at login. Only the owner; every counter only goes up; one write every 20 s; only the
    // fields below (so the size is bounded); createdAt never changes. A guest has them too, so
    // they stay when the guest creates an account (same uid).
    match /stats/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validStats({})
                    && request.resource.data.createdAt == request.time;
      allow update: if isOwner(userId) && validStats(resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.time > resource.data.lastSeen + duration.value(20, 's');
      allow delete: if false;
    }

    // The public profile, what the site's Perfil, the friends list and the friends ranking read. No
    // email. The nickname and the code must be the account's own (checked only when they change),
    // and each best carries the signature the ranking API gave it (the same one its board entry has).
    // The shown nickname must fold to its key ("José_1" -> "jose_1"), so it can't show a name the
    // account doesn't own, and the counters can't grow faster than the clock (perfilPace).
    match /perfis/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId) && notBanned() && isAccount() && validPerfil(userId)
                    && (resource == null || request.time > resource.data.lastSeen + duration.value(10, 's'));
      allow delete: if false;
    }

    // Presents from the admin (alpha testers): coins and looks the server writes (api/admin/presentes,
    // a service account, which skips these rules). The player only reads them and deletes each one
    // once the game has added it to the save (Online/GiftInbox).
    match /presentes/{userId}/itens/{id} {
      allow read, delete: if isOwner(userId);
      allow create, update: if false;
    }

    // A message from one account to another: "pedido" (a friend request), "aceito" (the other side
    // accepted: they already list this player) or "removido". The id is <para>_<de>. Only the two
    // can read it, and either one can delete it. The game only lists its own: where para == uid.
    match /pedidos/{id} {
      allow read: if request.auth != null && (resource.data.para == request.auth.uid || resource.data.de == request.auth.uid);
      allow create: if isAccount() && validPedido(id);
      allow update: if false;
      // by the id, not the document: answering a request also clears one that may not be there
      allow delete: if request.auth != null && request.auth.uid in id.split('_');
    }

    // The friends of an account, up to 50. A uid only goes in when it sent this player a message or
    // already lists this player; "novo" names the one going in, so the rules can look it up.
    match /amigos/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isAccount() && validFriends(userId);
      allow delete: if false;
    }

    function notBanned() {
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    // not a guest
    function isAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Every counter stays at or above what the document had (so it can't go missing or negative,
    // and a text there is an error, which refuses the write). Written out in the cheapest way: the
    // rules stop at 1000 evaluated expressions per request, and a helper function per field passed it.
    function validStats(o) {
      let d = request.resource.data;
      return d.keys().hasOnly([
                               'runsManual', 'runsAuto', 'secManual', 'secAuto', 'longestRun', 'kills',
                               'killsAuto', 'deaths', 'bestCombo', 'nights', 'bloodMoons', 'coinsEarned',
                               'coinsSpent', 'chests', 'k_bug', 'k_bat', 'k_licker', 'k_golem',
                               'k_golemRed', 'k_shield', 'k_sorcerer', 'k_supreme', 'k_cyclops', 'k_other',
                               'w_sword', 'w_greatsword', 'w_fury', 'w_gun', 'w_shotgun', 'w_grenade',
                               'w_staff', 'w_other', 'd_bug', 'd_bat', 'd_licker', 'd_golem',
                               'd_golemRed', 'd_shield', 'd_sorcerer', 'd_supreme', 'd_cyclops', 'd_fall',
                               'd_grenade', 'd_mine', 'd_spike', 'd_vomit', 'd_beam', 'd_shock',
                               'd_acid', 'd_other', 'runsEasy', 'runsMedium', 'runsHard',
                               'bestEasy', 'bestMedium', 'bestHard', 'bestAutoEasy', 'bestAutoMedium',
                               'bestAutoHard', 'createdAt', 'lastSeen'
             ])
          && d.lastSeen == request.time
          && o.get('runsManual', 0) <= d.get('runsManual', 0)
          && o.get('runsAuto', 0) <= d.get('runsAuto', 0)
          && o.get('secManual', 0) <= d.get('secManual', 0)
          && o.get('secAuto', 0) <= d.get('secAuto', 0)
          && o.get('longestRun', 0) <= d.get('longestRun', 0)
          && o.get('kills', 0) <= d.get('kills', 0)
          && o.get('killsAuto', 0) <= d.get('killsAuto', 0)
          && o.get('deaths', 0) <= d.get('deaths', 0)
          && o.get('bestCombo', 0) <= d.get('bestCombo', 0)
          && o.get('nights', 0) <= d.get('nights', 0)
          && o.get('bloodMoons', 0) <= d.get('bloodMoons', 0)
          && o.get('coinsEarned', 0) <= d.get('coinsEarned', 0)
          && o.get('coinsSpent', 0) <= d.get('coinsSpent', 0)
          && o.get('chests', 0) <= d.get('chests', 0)
          && o.get('k_bug', 0) <= d.get('k_bug', 0)
          && o.get('k_bat', 0) <= d.get('k_bat', 0)
          && o.get('k_licker', 0) <= d.get('k_licker', 0)
          && o.get('k_golem', 0) <= d.get('k_golem', 0)
          && o.get('k_golemRed', 0) <= d.get('k_golemRed', 0)
          && o.get('k_shield', 0) <= d.get('k_shield', 0)
          && o.get('k_sorcerer', 0) <= d.get('k_sorcerer', 0)
          && o.get('k_supreme', 0) <= d.get('k_supreme', 0)
          && o.get('k_cyclops', 0) <= d.get('k_cyclops', 0)
          && o.get('k_other', 0) <= d.get('k_other', 0)
          && o.get('w_sword', 0) <= d.get('w_sword', 0)
          && o.get('w_greatsword', 0) <= d.get('w_greatsword', 0)
          && o.get('w_fury', 0) <= d.get('w_fury', 0)
          && o.get('w_gun', 0) <= d.get('w_gun', 0)
          && o.get('w_shotgun', 0) <= d.get('w_shotgun', 0)
          && o.get('w_grenade', 0) <= d.get('w_grenade', 0)
          && o.get('w_staff', 0) <= d.get('w_staff', 0)
          && o.get('w_other', 0) <= d.get('w_other', 0)
          && o.get('d_bug', 0) <= d.get('d_bug', 0)
          && o.get('d_bat', 0) <= d.get('d_bat', 0)
          && o.get('d_licker', 0) <= d.get('d_licker', 0)
          && o.get('d_golem', 0) <= d.get('d_golem', 0)
          && o.get('d_golemRed', 0) <= d.get('d_golemRed', 0)
          && o.get('d_shield', 0) <= d.get('d_shield', 0)
          && o.get('d_sorcerer', 0) <= d.get('d_sorcerer', 0)
          && o.get('d_supreme', 0) <= d.get('d_supreme', 0)
          && o.get('d_cyclops', 0) <= d.get('d_cyclops', 0)
          && o.get('d_fall', 0) <= d.get('d_fall', 0)
          && o.get('d_grenade', 0) <= d.get('d_grenade', 0)
          && o.get('d_mine', 0) <= d.get('d_mine', 0)
          && o.get('d_spike', 0) <= d.get('d_spike', 0)
          && o.get('d_vomit', 0) <= d.get('d_vomit', 0)
          && o.get('d_beam', 0) <= d.get('d_beam', 0)
          && o.get('d_shock', 0) <= d.get('d_shock', 0)
          && o.get('d_acid', 0) <= d.get('d_acid', 0)
          && o.get('d_other', 0) <= d.get('d_other', 0)
          && o.get('runsEasy', 0) <= d.get('runsEasy', 0)
          && o.get('runsMedium', 0) <= d.get('runsMedium', 0)
          && o.get('runsHard', 0) <= d.get('runsHard', 0)
          && o.get('bestEasy', 0) <= d.get('bestEasy', 0)
          && o.get('bestMedium', 0) <= d.get('bestMedium', 0)
          && o.get('bestHard', 0) <= d.get('bestHard', 0)
          && o.get('bestAutoEasy', 0) <= d.get('bestAutoEasy', 0)
          && o.get('bestAutoMedium', 0) <= d.get('bestAutoMedium', 0)
          && o.get('bestAutoHard', 0) <= d.get('bestAutoHard', 0);
    }

    function num(d, f) {
      return f in d && d[f] is int && d[f] >= 0 && d[f] <= 1000000000000;
    }

    function text(d, f, max) {
      return f in d && d[f] is string && d[f].size() <= max;
    }

    function validPerfil(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['apelido', 'chave', 'codigo', 'helmet', 'cape', 'color', 'suit', 'rebirths', 'lastSeen',
                               'bestEasy', 'bestMedium', 'bestHard', 'sigEasy', 'sigMedium', 'sigHard', 'runsManual', 'runsAuto', 'secManual', 'secAuto', 'longestRun', 'kills', 'deaths', 'bestCombo',
                               'k_cyclops', 'k_supreme', 'nights', 'bloodMoons', 'chests', 'coinsEarned'])
          && d.lastSeen == request.time
          && text(d, 'apelido', 16) && d.apelido.size() >= 3
          && text(d, 'chave', 16) && text(d, 'codigo', 10)
          && text(d, 'helmet', 32) && text(d, 'cape', 32) && text(d, 'color', 32) && text(d, 'suit', 32)
          && d.rebirths is int && d.rebirths >= 0 && d.rebirths <= 999
          && d.keys().hasAll(['runsManual', 'runsAuto', 'secManual', 'secAuto', 'longestRun', 'kills', 'deaths', 'bestCombo',
                              'k_cyclops', 'k_supreme', 'nights', 'bloodMoons', 'chests', 'coinsEarned'])
          && d.runsManual >= 0 && d.runsAuto >= 0 && d.secManual >= 0 && d.secAuto >= 0 && d.longestRun >= 0
          && d.kills >= 0 && d.deaths >= 0 && d.bestCombo >= 0 && d.k_cyclops >= 0 && d.k_supreme >= 0
          && d.nights >= 0 && d.bloodMoons >= 0 && d.chests >= 0 && d.coinsEarned >= 0
          && d.chave == nickKey(d.apelido)
          && ownsNick(d, userId) && ownsCode(d, userId)
          && paced(d, userId)
          && bestOk(d, userId, 'bestEasy', 'sigEasy', 'leaderboard_easy')
          && bestOk(d, userId, 'bestMedium', 'sigMedium', 'leaderboard_medium')
          && bestOk(d, userId, 'bestHard', 'sigHard', 'leaderboard_hard');
    }

    // the same key as before, or one this account owns after the commit; a new key also frees the
    // old one in the same commit (one nickname per account)
    function ownsNick(d, userId) {
      return (resource != null && resource.data.chave == d.chave)
          || (getAfter(/databases/$(database)/documents/apelidos/$(d.chave)).data.uid == userId
              && (resource == null || resource.data.chave == ''
                  || !existsAfter(/databases/$(database)/documents/apelidos/$(resource.data.chave))));
    }

    // no code, the same one as before, or a first one this account owns after the commit; once set
    // it never changes (one code per account)
    function ownsCode(d, userId) {
      return d.codigo == '' || (resource != null && resource.data.codigo == d.codigo)
          || ((resource == null || resource.data.codigo == '')
              && getAfter(/databases/$(database)/documents/codigos/$(d.codigo)).data.uid == userId);
    }

    // "José_1" -> "jose_1": the game's ProfileService.NickKey (lowercase, accents off). Anything
    // else stays, and the key's own pattern refuses it.
    function nickKey(n) {
      return n.lower().replace('[áàâãä]', 'a').replace('[éèêë]', 'e').replace('[íìîï]', 'i')
          .replace('[óòôõö]', 'o').replace('[úùûü]', 'u').replace('ç', 'c').replace('ñ', 'n');
    }

    // How much the public counters may grow in one write, for `a` seconds of play allowed: play
    // time a; runs and deaths a/5 (+10); kills 10 a second; Ciclopes and Feiticeiros a/5 (+10);
    // nights, Blood Moons and chests a/3 (+10); coins 200 a second; a new longest run no longer than
    // twice the play time (game time runs up to 1.5x); a new best combo at most 1000.0x. A peak
    // that didn't change isn't checked again (older documents). Kept short: the rules stop at 1000
    // evaluated expressions per commit, and a new nickname commits with its profile.
    // (stats/ itself can't take this: its 60 fields already use most of that budget.)
    function perfilPace(d, o, a) {
      return d.secManual + d.secAuto - o.secManual - o.secAuto <= a
          && d.runsManual + d.runsAuto + d.deaths - o.runsManual - o.runsAuto - o.deaths <= a / 5 + 10
          && d.kills - o.kills <= 10 * a
          && d.k_cyclops + d.k_supreme - o.k_cyclops - o.k_supreme <= a / 5 + 10
          && d.nights + d.bloodMoons + d.chests - o.nights - o.bloodMoons - o.chests <= a / 3 + 10
          && d.coinsEarned - o.coinsEarned <= 200 * a
          && (d.longestRun == o.longestRun || d.longestRun <= 2 * (d.secManual + d.secAuto) + 60)
          && (d.bestCombo == o.bestCombo || d.bestCombo <= 10000);
    }

    // an update: twice the real time since the last write (+10 min). A first profile starts from
    // zero with twice the time since the account's stats/ began, plus 6 h from before the login.
    function paced(d, userId) {
      let stats = /databases/$(database)/documents/stats/$(userId);
      return resource != null
          ? perfilPace(d, resource.data, 2 * (request.time - resource.data.lastSeen).seconds() + 600)
          : perfilPace(d, {'secManual': 0, 'secAuto': 0, 'runsManual': 0, 'runsAuto': 0, 'deaths': 0, 'kills': 0,
                           'k_cyclops': 0, 'k_supreme': 0, 'nights': 0, 'bloodMoons': 0, 'chests': 0,
                           'coinsEarned': 0, 'longestRun': 0, 'bestCombo': 0},
                       (exists(stats) ? 2 * (request.time - get(stats).data.createdAt).seconds() : 0) + 21600);
    }

    // no best yet, or the signature of the board's score: sha256("<key>|<uid>|<board>|<score>")
    function bestOk(d, userId, best, sig, board) {
      return num(d, best) && (d[best] == 0
          || d[sig] == hashing.sha256('__SCORE_KEY__|' + userId + '|' + board + '|' + string(d[best])).toHexString().lower());
    }

    function validPedido(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['de', 'para', 'tipo', 'apelido', 'criadoEm'])
          && d.de == request.auth.uid && d.para is string && d.para != d.de
          && id == d.para + '_' + d.de
          && d.tipo in ['pedido', 'aceito', 'removido']
          && d.apelido is string && d.apelido.size() <= 16
          && d.criadoEm == request.time
          && (d.tipo != 'aceito' || get(/databases/$(database)/documents/amigos/$(d.de)).data.lista.hasAny([d.para]));
    }

    function validFriends(userId) {
      let d = request.resource.data;
      let before = resource == null ? [] : resource.data.lista;
      let added = d.lista.toSet().difference(before.toSet());
      return d.keys().hasOnly(['lista', 'novo', 'updatedAt'])
          && d.updatedAt == request.time
          && d.lista is list && d.lista.size() <= 50
          && d.lista.toSet().size() == d.lista.size()
          && !d.lista.hasAny([userId])
          && d.novo is string
          && ((d.novo == '' && added.size() == 0)
              || (d.novo != '' && added.size() == 1 && added.hasAll([d.novo]) && canAdd(userId, d.novo)));
    }

    function canAdd(userId, other) {
      return exists(/databases/$(database)/documents/pedidos/$(userId + '_' + other))
          || (exists(/databases/$(database)/documents/amigos/$(other))
              && get(/databases/$(database)/documents/amigos/$(other)).data.lista.hasAny([userId]));
    }

    // the all-time boards, and the daily ones (daily_<level>_<yyyymmdd>, Brasília day) the site's
    // Diário tab reads; the API's signature names the board, so a score only lands on the day the
    // API gave it
    function isBoard(board) {
      return board in ['leaderboard_hard', 'leaderboard_freny', 'leaderboard_medium', 'leaderboard_easy']
          || board.matches('daily_(hard|freny|medium|easy)_20[0-9]{6}')
          || board.matches('auto_(hard|freny|medium|easy)');   // the autopilot's boards (2026-11-01)
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'score', 'sig', 'rebirths', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 16
          && (!('rebirths' in d) || (d.rebirths is int && d.rebirths >= 0 && d.rebirths <= 999))
          && d.score is int && d.score >= 0 && d.score <= 1000000000
          && d.updatedAt == request.time;
    }

    // sig = sha256("<key>|<uid>|<board>|<score>") in hex, made by the ranking API with its SCORE_KEY
    // (a Vercel env var; the game no longer has a key). The key below is a placeholder that
    // Tools/ScoreKey/make_score_key.py swaps for the secret (see docs/firebase/SETUP.md).
    function validSig(board, userId) {
      let d = request.resource.data;
      return d.sig == hashing.sha256('__SCORE_KEY__|' + userId + '|' + board + '|' + string(d.score)).toHexString().lower();
    }

    function validAchievements(userId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['played', 'million', 'cyclops', 'supreme', 'grenade5', 'oops', 'shotgun3',
                               'backstab', 'eye', 'combo5', 'combo50', 'survivor', 'cyclops3', 'kills500', 'marathon', 'title', 'updatedAt'])
          && d.updatedAt == request.time
          && validTitle(d)
          && (resource == null || d.keys().hasAll(resource.data.keys()))
          && achSig(d, userId, 'played') && achSig(d, userId, 'million') && achSig(d, userId, 'cyclops')
          && achSig(d, userId, 'supreme') && achSig(d, userId, 'grenade5') && achSig(d, userId, 'oops')
          && achSig(d, userId, 'shotgun3') && achSig(d, userId, 'backstab') && achSig(d, userId, 'eye')
          && achSig(d, userId, 'combo5') && achSig(d, userId, 'combo50') && achSig(d, userId, 'survivor')
          && achSig(d, userId, 'cyclops3') && achSig(d, userId, 'kills500') && achSig(d, userId, 'marathon');
    }

    function validTitle(d) {
      return !('title' in d) || d.title == '' || d.title == 'rei'
          || (d.title in ['played', 'million', 'cyclops', 'supreme', 'grenade5', 'oops', 'shotgun3',
                          'backstab', 'eye', 'combo5', 'combo50', 'survivor', 'cyclops3', 'kills500', 'marathon'] && d.title in d);
    }

    // missing, or sha256("<key>|<uid>|ach|<id>") from the ranking API
    function achSig(d, userId, id) {
      return !(id in d)
          || d[id] == hashing.sha256('__SCORE_KEY__|' + userId + '|ach|' + id).toHexString().lower();
    }

    function validSave() {
      let d = request.resource.data;
      return d.keys().hasOnly(['playerName', 'bestScore', 'runsPlayed', 'totalCoins', 'updatedAt'])
          && d.playerName is string && d.playerName.size() <= 16
          && d.bestScore is int && d.runsPlayed is int && d.totalCoins is int;
    }
  }
}
